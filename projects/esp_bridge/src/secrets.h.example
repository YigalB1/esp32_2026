// secrets.h.example
//
// Copy this file to "secrets.h" (same folder) and fill in your real
// WiFi/MQTT credentials there. secrets.h itself is gitignored and will
// NEVER be committed - only this .example template is tracked in git,
// so anyone cloning the repo knows what to fill in without your real
// credentials ever touching version control.

#pragma once

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
#define MQTT_BROKER_HOST "192.168.1.50"  // Win11 PC's LAN IP
